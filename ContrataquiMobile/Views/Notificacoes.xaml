<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ContrataquiMobile.Models"
             xmlns:views="clr-namespace:ContrataquiMobile.Views"
             x:Class="ContrataquiMobile.Views.Notificacoes"
             x:DataType="views:Notificacoes"
             Title="Notificações"
             BackgroundColor="#F9F9FF"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Color x:Key="Primary">#002045</Color>
        <Color x:Key="PrimaryContainer">#1A365D</Color>
        <Color x:Key="Secondary">#13696A</Color>
        <Color x:Key="OnSurface">#111C2C</Color>
        <Color x:Key="OnSurfaceVariant">#43474E</Color>
        <Color x:Key="Outline">#74777F</Color>
        <Color x:Key="SurfaceLow">#F0F3FF</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="4"
              Padding="12,12,20,12">
            <Grid WidthRequest="44" HeightRequest="44">
                <Label Text="&#xE5C4;"
                       FontFamily="MaterialIcons"
                       FontSize="24"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Voltar_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <Label Grid.Column="1"
                   Text="Notificações"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryContainer}"
                   VerticalOptions="Center" />

            <Label x:Name="lbl_marcar_todas"
                   Grid.Column="2"
                   Text="Marcar todas"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Secondary}"
                   VerticalOptions="Center"
                   IsVisible="False">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="MarcarTodas_Tapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <RefreshView x:Name="rfv_lista"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Secondary}"
                     Refreshing="Atualizar_Refreshing">
            <ScrollView>
                <VerticalStackLayout Padding="20,8,20,32" Spacing="12">

                    <ActivityIndicator x:Name="ind_carregando"
                                       Color="{StaticResource Secondary}"
                                       IsRunning="False"
                                       IsVisible="False" />

                    <!-- Lista vazia -->
                    <VerticalStackLayout x:Name="stk_vazio"
                                         IsVisible="False"
                                         Spacing="8"
                                         Padding="0,56,0,0"
                                         HorizontalOptions="Center">
                        <Label Text="&#xE7F4;"
                               FontFamily="MaterialIcons"
                               FontSize="56"
                               TextColor="#C4C6CF"
                               HorizontalOptions="Center" />
                        <Label Text="Você não tem notificações"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" />
                        <Label Text="Avisos de contratos, propostas e mensagens aparecem aqui."
                               FontSize="12"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Lista -->
                    <VerticalStackLayout Spacing="10"
                                         BindableLayout.ItemsSource="{Binding Itens}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Notificacao">
                                <Border BackgroundColor="{Binding CorFundo}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="14">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                        <Border WidthRequest="44"
                                                HeightRequest="44"
                                                BackgroundColor="{StaticResource SurfaceLow}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 22"
                                                VerticalOptions="Start">
                                            <Label Text="{Binding Icone}"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="22"
                                                   TextColor="{Binding CorIcone}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Titulo}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                            <Label Text="{Binding Mensagem}"
                                                   IsVisible="{Binding TemMensagem}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource OnSurfaceVariant}"
                                                   MaxLines="3"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Tempo}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Outline}"
                                                   Margin="0,2,0,0" />
                                        </VerticalStackLayout>

                                        <!-- Bolinha de não lida -->
                                        <Border Grid.Column="2"
                                                WidthRequest="10"
                                                HeightRequest="10"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 5"
                                                BackgroundColor="{StaticResource Secondary}"
                                                IsVisible="{Binding NaoLida}"
                                                VerticalOptions="Start"
                                                Margin="0,6,0,0" />
                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Item_Tapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <views:BarraNavegacao Grid.Row="2" />

    </Grid>
</ContentPage>