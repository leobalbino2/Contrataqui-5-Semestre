<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContrataquiMobile.Views.EditarPerfil"
             Title="Editar perfil"
             BackgroundColor="#F9F9FF"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Color x:Key="Primary">#002045</Color>
        <Color x:Key="PrimaryContainer">#1A365D</Color>
        <Color x:Key="Secondary">#13696A</Color>
        <Color x:Key="Accent">#FFB866</Color>
        <Color x:Key="OnAccent">#321B00</Color>
        <Color x:Key="OnSurface">#111C2C</Color>
        <Color x:Key="OnSurfaceVariant">#43474E</Color>
        <Color x:Key="Outline">#74777F</Color>

        <Style x:Key="CampoBorda" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F9F9FF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="#E1E8F5" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="CampoEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
            <Setter Property="PlaceholderColor" Value="#9AA0A8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="CampoPicker" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
            <Setter Property="TitleColor" Value="#9AA0A8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="CampoLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
        </Style>

        <Style x:Key="TituloSecao" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="4"
              Padding="12,12,20,12">
            <Grid WidthRequest="44" HeightRequest="44">
                <Label Text="&#xE5C4;"
                       FontFamily="MaterialIcons"
                       FontSize="24"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Voltar_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>
            <Label Grid.Column="1"
                   Text="Editar perfil"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryContainer}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Conteúdo -->
        <Grid Grid.Row="1">

            <ActivityIndicator x:Name="ind_carregando"
                               Color="{StaticResource Secondary}"
                               IsRunning="False"
                               IsVisible="False"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <Label x:Name="lbl_erro"
                   FontSize="13"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Padding="24"
                   IsVisible="False">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Erro_Tapped" />
                </Label.GestureRecognizers>
            </Label>

            <ScrollView x:Name="scv_conteudo" IsVisible="False">
                <VerticalStackLayout Padding="20,8,20,24" Spacing="16">

                    <!-- Foto -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Foto de perfil" Style="{StaticResource TituloSecao}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border WidthRequest="80"
                                        HeightRequest="80"
                                        BackgroundColor="#F9F9FF"
                                        Stroke="#C4C6CF"
                                        StrokeThickness="1"
                                        StrokeDashArray="4,3"
                                        StrokeShape="RoundRectangle 40">
                                    <Grid>
                                        <Label x:Name="lbl_foto_vazia"
                                               Text="Foto"
                                               FontSize="12"
                                               TextColor="{StaticResource Outline}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <Image x:Name="img_foto"
                                               Aspect="AspectFill"
                                               IsVisible="False" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Foto_Tapped" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label x:Name="lbl_trocar_foto"
                                           Text="Adicionar foto"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Foto_Tapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="JPG ou PNG."
                                           FontSize="12"
                                           TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Dados pessoais -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="20">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="Dados pessoais" Style="{StaticResource TituloSecao}" />

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Nome completo" Style="{StaticResource CampoLabel}" />
                                <Border Style="{StaticResource CampoBorda}">
                                    <Entry x:Name="txt_nome"
                                           Placeholder="Seu nome completo"
                                           Style="{StaticResource CampoEntry}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="WhatsApp / Telefone" Style="{StaticResource CampoLabel}" />
                                <Border Style="{StaticResource CampoBorda}">
                                    <Entry x:Name="txt_telefone"
                                           Placeholder="(11) 98765-4321"
                                           Keyboard="Telephone"
                                           MaxLength="15"
                                           TextChanged="Telefone_TextChanged"
                                           Style="{StaticResource CampoEntry}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Só profissional -->
                            <VerticalStackLayout x:Name="stk_sobre" Spacing="6" IsVisible="False">
                                <Label Text="Sobre você" Style="{StaticResource CampoLabel}" />
                                <Border Style="{StaticResource CampoBorda}"
                                        HeightRequest="120"
                                        Padding="14,8">
                                    <Editor x:Name="txt_descricao"
                                            Placeholder="Conte sobre sua experiência, especialidades e diferenciais..."
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource OnSurface}"
                                            PlaceholderColor="#9AA0A8"
                                            FontSize="14" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Endereço -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="20">
                        <VerticalStackLayout Spacing="16">
                            <Label x:Name="lbl_titulo_endereco"
                                   Text="Endereço"
                                   Style="{StaticResource TituloSecao}" />

                            <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Estado" Style="{StaticResource CampoLabel}" />
                                    <Border Style="{StaticResource CampoBorda}">
                                        <Picker x:Name="pck_estado"
                                                Title="UF"
                                                Style="{StaticResource CampoPicker}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Cidade" Style="{StaticResource CampoLabel}" />
                                    <Border Style="{StaticResource CampoBorda}">
                                        <Entry x:Name="txt_cidade"
                                               Placeholder="Cidade"
                                               Style="{StaticResource CampoEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="CEP" Style="{StaticResource CampoLabel}" />
                                    <Border Style="{StaticResource CampoBorda}">
                                        <Entry x:Name="txt_cep"
                                               Placeholder="00000-000"
                                               Keyboard="Numeric"
                                               MaxLength="9"
                                               TextChanged="Cep_TextChanged"
                                               Style="{StaticResource CampoEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Número" Style="{StaticResource CampoLabel}" />
                                    <Border Style="{StaticResource CampoBorda}">
                                        <Entry x:Name="txt_numero"
                                               Placeholder="Número"
                                               Style="{StaticResource CampoEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Rua" Style="{StaticResource CampoLabel}" />
                                <Border Style="{StaticResource CampoBorda}">
                                    <Entry x:Name="txt_rua"
                                           Placeholder="Nome da rua"
                                           Style="{StaticResource CampoEntry}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Complemento (opcional)" Style="{StaticResource CampoLabel}" />
                                <Border Style="{StaticResource CampoBorda}">
                                    <Entry x:Name="txt_complemento"
                                           Placeholder="Apto, bloco..."
                                           Style="{StaticResource CampoEntry}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Serviços (só profissional) -->
                    <Border x:Name="brd_servicos"
                            IsVisible="False"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Serviços oferecidos" Style="{StaticResource TituloSecao}" />
                            <Label Text="Marque os serviços que você realiza."
                                   FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}" />

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Filtrar por categoria" Style="{StaticResource CampoLabel}" />
                                <Border Style="{StaticResource CampoBorda}">
                                    <Picker x:Name="pck_categoria"
                                            Title="Todas as categorias"
                                            SelectedIndexChanged="Categoria_Changed"
                                            Style="{StaticResource CampoPicker}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="stk_servicos" Spacing="0" />

                            <Label x:Name="lbl_qtd_servicos"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Botões (fixos embaixo) -->
        <VerticalStackLayout x:Name="stk_botoes"
                             Grid.Row="2"
                             IsVisible="False"
                             BackgroundColor="White"
                             Spacing="0">
            <BoxView HeightRequest="1" Color="#E1E8F5" />
            <Grid ColumnDefinitions="*,2*" ColumnSpacing="12" Padding="20,10">
                <Button x:Name="btn_cancelar"
                        Text="Cancelar"
                        Clicked="Voltar_Clicked"
                        BackgroundColor="#E7EEFF"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="8"
                        HeightRequest="48" />
                <Button x:Name="btn_salvar"
                        Grid.Column="1"
                        Text="Salvar alterações"
                        Clicked="Salvar_Clicked"
                        BackgroundColor="{StaticResource Accent}"
                        TextColor="{StaticResource OnAccent}"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="8"
                        HeightRequest="48" />
            </Grid>
        </VerticalStackLayout>

    </Grid>
</ContentPage>