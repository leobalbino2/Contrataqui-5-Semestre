<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContrataquiMobile.Views.Cadastro"
             Title="Cadastro"
             BackgroundColor="#F9F9FF"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Color x:Key="Primary">#002045</Color>
        <Color x:Key="Secondary">#13696A</Color>
        <Color x:Key="SecondaryContainer">#A2EDED</Color>
        <Color x:Key="Accent">#FFB866</Color>
        <Color x:Key="OnAccent">#321B00</Color>
        <Color x:Key="OnSurface">#111C2C</Color>
        <Color x:Key="OnSurfaceVariant">#43474E</Color>
        <Color x:Key="Outline">#74777F</Color>

        <Style x:Key="CampoBorda" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="CampoEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
            <Setter Property="PlaceholderColor" Value="#9AA0A8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="CampoLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
        </Style>

        <Style x:Key="ToggleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Outline}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24,32"
                             Spacing="20"
                             VerticalOptions="Center"
                             MaximumWidthRequest="420">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="4">
                <Label Text="CONTRATAQUI"
                       FontSize="12"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       TextColor="{StaticResource Secondary}" />
                <Label Text="Crie sua conta"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <Label Text="Encontre os melhores eletricistas, encanadores, pintores e mais para o seu lar."
                       FontSize="14"
                       TextColor="{StaticResource OnSurfaceVariant}" />
            </VerticalStackLayout>

            <!-- Seletor de perfil -->
            <Border BackgroundColor="#E7EEFF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="4">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="0,10">
                        <Label Text="Quero Contratar"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="0,10">
                        <Label Text="Sou Profissional"
                               FontSize="12"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SouProfissional_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <!-- Nome -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Nome completo" Style="{StaticResource CampoLabel}" />
                <Border Style="{StaticResource CampoBorda}">
                    <Entry x:Name="txt_nome"
                           Placeholder="Ex.: Lucas Silveira"
                           Keyboard="Text"
                           Style="{StaticResource CampoEntry}" />
                </Border>
            </VerticalStackLayout>

            <!-- E-mail -->
            <VerticalStackLayout Spacing="6">
                <Label Text="E-mail" Style="{StaticResource CampoLabel}" />
                <Border Style="{StaticResource CampoBorda}">
                    <Entry x:Name="txt_email"
                           Placeholder="seu@email.com"
                           Keyboard="Email"
                           Style="{StaticResource CampoEntry}" />
                </Border>
            </VerticalStackLayout>

            <!-- Telefone -->
            <VerticalStackLayout Spacing="6">
                <Label Text="WhatsApp / Telefone" Style="{StaticResource CampoLabel}" />
                <Border Style="{StaticResource CampoBorda}">
                    <Entry x:Name="txt_telefone"
                           Placeholder="(11) 98765-4321"
                           Keyboard="Telephone"
                           MaxLength="15"
                           TextChanged="Telefone_TextChanged"
                           Style="{StaticResource CampoEntry}" />
                </Border>
            </VerticalStackLayout>

            <!-- Senha -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Criar senha" Style="{StaticResource CampoLabel}" />
                <Border Style="{StaticResource CampoBorda}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry x:Name="txt_senha"
                               Placeholder="Mínimo 8 caracteres"
                               IsPassword="True"
                               Style="{StaticResource CampoEntry}" />
                        <Label x:Name="lbl_toggle_senha"
                               Grid.Column="1"
                               Text="Mostrar"
                               Style="{StaticResource ToggleLabel}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ToggleSenha_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Confirmar senha -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Confirmar senha" Style="{StaticResource CampoLabel}" />
                <Border Style="{StaticResource CampoBorda}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry x:Name="txt_confirmar_senha"
                               Placeholder="Repita a senha"
                               IsPassword="True"
                               Style="{StaticResource CampoEntry}" />
                        <Label x:Name="lbl_toggle_confirmar"
                               Grid.Column="1"
                               Text="Mostrar"
                               Style="{StaticResource ToggleLabel}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ToggleConfirmar_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Termos -->
            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="chk_termos"
                          Color="{StaticResource Secondary}"
                          VerticalOptions="Start" />
                <Label FontSize="12"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       VerticalOptions="Center"
                       WidthRequest="290">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Li e aceito os " />
                            <Span Text="Termos de Uso"
                                  FontAttributes="Bold"
                                  TextColor="{StaticResource Secondary}" />
                            <Span Text=" e a " />
                            <Span Text="Política de Privacidade"
                                  FontAttributes="Bold"
                                  TextColor="{StaticResource Secondary}" />
                            <Span Text=" do Contrataqui." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </HorizontalStackLayout>

            <!-- Botão -->
            <Button x:Name="btn_cadastrar"
                    Text="Criar conta de cliente"
                    Clicked="Cadastrar_Clicked"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="{StaticResource OnAccent}"
                    FontAttributes="Bold"
                    FontSize="14"
                    CornerRadius="8"
                    HeightRequest="48" />

            <!-- Já tem conta -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="Já tem uma conta?"
                       FontSize="12"
                       TextColor="{StaticResource OnSurfaceVariant}" />
                <Label Text="Fazer login"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Secondary}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Login_Tapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>