<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ContrataquiMobile.Models"
             xmlns:views="clr-namespace:ContrataquiMobile.Views"
             x:Class="ContrataquiMobile.Views.PerfilProfissional"
             x:DataType="models:Profissional"
             Title="Perfil"
             BackgroundColor="#F9F9FF"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Color x:Key="Primary">#002045</Color>
        <Color x:Key="PrimaryContainer">#1A365D</Color>
        <Color x:Key="Secondary">#13696A</Color>
        <Color x:Key="Accent">#FFB866</Color>
        <Color x:Key="OnAccent">#321B00</Color>
        <Color x:Key="OnSurface">#111C2C</Color>
        <Color x:Key="OnSurfaceVariant">#43474E</Color>
        <Color x:Key="Outline">#74777F</Color>
        <Color x:Key="SurfaceLow">#F0F3FF</Color>

        <Style x:Key="TituloSecao" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="4"
              Padding="12,12,20,12">
            <Grid WidthRequest="44" HeightRequest="44">
                <Label Text="&#xE5C4;"
                       FontFamily="MaterialIcons"
                       FontSize="24"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Voltar_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>
            <Label Grid.Column="1"
                   Text="Perfil do profissional"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryContainer}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Conteúdo -->
        <Grid Grid.Row="1">

            <ActivityIndicator x:Name="ind_carregando"
                               Color="{StaticResource Secondary}"
                               IsRunning="False"
                               IsVisible="False"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <Label x:Name="lbl_erro"
                   FontSize="13"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Padding="24"
                   IsVisible="False">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Erro_Tapped" />
                </Label.GestureRecognizers>
            </Label>

            <ScrollView x:Name="scv_conteudo" IsVisible="False">
                <VerticalStackLayout Padding="20,8,20,24" Spacing="16">

                    <!-- Cartão do profissional -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="20">
                        <VerticalStackLayout Spacing="14">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">

                                <Grid WidthRequest="92" HeightRequest="92" VerticalOptions="Start">
                                    <Border WidthRequest="86"
                                            HeightRequest="86"
                                            StrokeThickness="3"
                                            Stroke="#E7EEFF"
                                            StrokeShape="RoundRectangle 43"
                                            BackgroundColor="{StaticResource PrimaryContainer}"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start">
                                        <Grid>
                                            <Label Text="{Binding Iniciais}"
                                                   FontSize="30"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Image Source="{Binding ImagemPerfil}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding TemFoto}" />
                                        </Grid>
                                    </Border>
                                    <Border WidthRequest="26"
                                            HeightRequest="26"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 13"
                                            BackgroundColor="White"
                                            HorizontalOptions="End"
                                            VerticalOptions="End">
                                        <Label Text="&#xE86C;"
                                               FontFamily="MaterialIcons"
                                               FontSize="22"
                                               TextColor="{StaticResource Secondary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="6"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Nome}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                    <Border BackgroundColor="#E6F6F6"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="8,3"
                                            HorizontalOptions="Start">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="&#xE86C;"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Secondary}"
                                                   VerticalOptions="Center" />
                                            <Label Text="VERIFICADO"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Secondary}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="{Binding ServicosTexto}"
                                   IsVisible="{Binding TemServicos}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />

                            <FlexLayout Wrap="Wrap" AlignItems="Center">
                                <Label IsVisible="{Binding TemNota}"
                                       FontSize="13"
                                       Margin="0,0,16,4">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="★ " TextColor="#D4903B" />
                                            <Span Text="{Binding Nota}"
                                                  FontAttributes="Bold"
                                                  TextColor="{StaticResource OnSurface}" />
                                            <Span Text="{Binding TotalAvaliacoesTexto}"
                                                  TextColor="{StaticResource OnSurfaceVariant}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <HorizontalStackLayout IsVisible="{Binding TemLocal}"
                                                       Spacing="2"
                                                       Margin="0,0,16,4">
                                    <Label Text="&#xE55F;"
                                           FontFamily="MaterialIcons"
                                           FontSize="16"
                                           TextColor="{StaticResource Outline}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Local}"
                                           FontSize="13"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Label Text="{Binding DesdeTexto}"
                                       IsVisible="{Binding TemAnoFundacao}"
                                       FontSize="13"
                                       TextColor="{StaticResource OnSurfaceVariant}"
                                       Margin="0,0,0,4" />
                            </FlexLayout>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Sobre -->
                    <Border IsVisible="{Binding TemDescricao}"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="20">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Sobre" Style="{StaticResource TituloSecao}" />
                            <Label Text="{Binding Descricao}"
                                   FontSize="14"
                                   LineHeight="1.3"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Serviços oferecidos -->
                    <Border IsVisible="{Binding TemServicos}"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Serviços oferecidos" Style="{StaticResource TituloSecao}" />

                            <VerticalStackLayout Spacing="10"
                                                 BindableLayout.ItemsSource="{Binding ListaServicos}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Servico">
                                        <Border BackgroundColor="White"
                                                Stroke="#E1E8F5"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="14">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Nome}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" />
                                                <Label Text="{Binding Descricao}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource OnSurfaceVariant}"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Categoria.Nome}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Secondary}" />
                                            </VerticalStackLayout>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="Servico_Tapped" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Avaliações dos clientes -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Avaliações dos clientes" Style="{StaticResource TituloSecao}" />

                            <Label x:Name="lbl_sem_avaliacoes"
                                   Text="Nenhuma avaliação ainda."
                                   FontSize="13"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   IsVisible="False" />

                            <VerticalStackLayout x:Name="stk_avaliacoes" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Avaliacao">
                                        <Border BackgroundColor="White"
                                                Stroke="#E1E8F5"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="14">
                                            <VerticalStackLayout Spacing="8">

                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Border WidthRequest="36"
                                                            HeightRequest="36"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 18"
                                                            BackgroundColor="#E7EEFF"
                                                            VerticalOptions="Start">
                                                        <Grid>
                                                            <Label Text="{Binding ClienteInicial}"
                                                                   FontSize="14"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource Primary}"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />
                                                            <Image Source="{Binding ClienteImagem}"
                                                                   Aspect="AspectFill"
                                                                   IsVisible="{Binding TemFoto}" />
                                                        </Grid>
                                                    </Border>

                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Spacing="1"
                                                                         VerticalOptions="Center">
                                                        <Label Text="{Binding ClienteNome}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}"
                                                               LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding ServicoTexto}"
                                                               IsVisible="{Binding TemServico}"
                                                               FontSize="11"
                                                               TextColor="{StaticResource OnSurfaceVariant}"
                                                               LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>

                                                    <Label Grid.Column="2"
                                                           FontSize="13"
                                                           VerticalOptions="Start">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding EstrelasCheias}" TextColor="#D4903B" />
                                                                <Span Text="{Binding EstrelasVazias}" TextColor="#C4C6CF" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </Grid>

                                                <Label Text="{Binding Comentario}"
                                                       IsVisible="{Binding TemComentario}"
                                                       FontSize="13"
                                                       LineHeight="1.3"
                                                       TextColor="{StaticResource OnSurfaceVariant}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Button x:Name="btn_ver_mais_avaliacoes"
                                    Text="Ver mais avaliações"
                                    Clicked="VerMaisAvaliacoes_Clicked"
                                    IsVisible="False"
                                    BackgroundColor="#E7EEFF"
                                    TextColor="{StaticResource Primary}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    CornerRadius="8"
                                    HeightRequest="44" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Como funciona a contratação -->
                    <Border BackgroundColor="{StaticResource SurfaceLow}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="20">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Contratar profissional" Style="{StaticResource TituloSecao}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE86C;"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{StaticResource Secondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Profissional verificado"
                                       FontSize="13"
                                       TextColor="{StaticResource OnSurfaceVariant}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE86C;"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{StaticResource Secondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Garantia Contrataqui"
                                       FontSize="13"
                                       TextColor="{StaticResource OnSurfaceVariant}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE86C;"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{StaticResource Secondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Valor combinado após análise do serviço"
                                       FontSize="13"
                                       TextColor="{StaticResource OnSurfaceVariant}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Label Text="O valor só é liberado quando o serviço for concluído com a sua aprovação."
                                   FontSize="12"
                                   TextColor="{StaticResource Outline}"
                                   Margin="0,4,0,0" />

                            <VerticalStackLayout IsVisible="{Binding TemLocal}" Spacing="4" Margin="0,8,0,0">
                                <Label Text="Área de atendimento"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                                <HorizontalStackLayout Spacing="2">
                                    <Label Text="&#xE55F;"
                                           FontFamily="MaterialIcons"
                                           FontSize="16"
                                           TextColor="{StaticResource Outline}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Local}"
                                           FontSize="13"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Barra de contratação (fica fixa embaixo) -->
        <VerticalStackLayout x:Name="stk_cta"
                             Grid.Row="2"
                             IsVisible="False"
                             BackgroundColor="White"
                             Spacing="0">
            <BoxView HeightRequest="1" Color="#E1E8F5" />
            <Button Text="Contratar Agora"
                    Clicked="Contratar_Clicked"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="{StaticResource OnAccent}"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="10"
                    HeightRequest="48"
                    Margin="20,10" />
        </VerticalStackLayout>

        <views:BarraNavegacao Grid.Row="3" />

    </Grid>
</ContentPage>