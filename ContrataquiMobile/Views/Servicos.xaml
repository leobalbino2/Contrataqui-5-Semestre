<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ContrataquiMobile.Models"
             xmlns:views="clr-namespace:ContrataquiMobile.Views"
             x:Class="ContrataquiMobile.Views.Servicos"
             x:DataType="views:Servicos"
             Title="Serviços"
             BackgroundColor="#F9F9FF"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Color x:Key="Primary">#002045</Color>
        <Color x:Key="PrimaryContainer">#1A365D</Color>
        <Color x:Key="Secondary">#13696A</Color>
        <Color x:Key="Accent">#FFB866</Color>
        <Color x:Key="OnSurface">#111C2C</Color>
        <Color x:Key="OnSurfaceVariant">#43474E</Color>
        <Color x:Key="SurfaceLow">#F0F3FF</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="4"
              Padding="12,12,20,12">
            <Grid WidthRequest="44" HeightRequest="44">
                <Label Text="&#xE5C4;"
                       FontFamily="MaterialIcons"
                       FontSize="24"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Voltar_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>
            <Label Grid.Column="1"
                   Text="Serviços"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryContainer}"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,32" Spacing="20">

                <!-- Topo com a imagem da categoria -->
                <Border BackgroundColor="{StaticResource PrimaryContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="190">
                    <Grid>
                        <Image Source="{Binding Categoria.ImagemSite}"
                               Aspect="AspectFill" />
                        <BoxView Color="#99002045" />
                        <VerticalStackLayout Padding="18"
                                             Spacing="6"
                                             VerticalOptions="End">
                            <Label Text="{Binding Categoria.Nome, StringFormat='Serviços de {0}'}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="{Binding Categoria.Descricao}"
                                   FontSize="13"
                                   TextColor="#E6EDFF"
                                   MaxLines="3"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Título da seção -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Especialidades disponíveis"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <BoxView Color="{StaticResource Accent}"
                             WidthRequest="48"
                             HeightRequest="4"
                             CornerRadius="2"
                             HorizontalOptions="Start" />
                </VerticalStackLayout>

                <ActivityIndicator x:Name="ind_carregando"
                                   Color="{StaticResource Secondary}"
                                   IsRunning="False"
                                   IsVisible="False" />

                <Label x:Name="lbl_vazio"
                       Text="Nenhum serviço encontrado para esta categoria."
                       FontSize="13"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalOptions="Center"
                       IsVisible="False" />

                <!-- Lista de serviços -->
                <VerticalStackLayout Spacing="14"
                                     BindableLayout.ItemsSource="{Binding Itens}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Servico">
                            <Border BackgroundColor="White"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                <VerticalStackLayout>
                                    <Grid HeightRequest="140"
                                          BackgroundColor="{StaticResource SurfaceLow}">
                                        <Image Source="{Binding Imagem}"
                                               Aspect="AspectFill" />
                                    </Grid>

                                    <VerticalStackLayout Padding="16" Spacing="6">
                                        <Label Text="{Binding Nome}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding Descricao}"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="Buscar profissionais →"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Secondary}"
                                               Margin="0,4,0,0" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BuscarProfissionais_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <views:BarraNavegacao Grid.Row="2" />

    </Grid>
</ContentPage>