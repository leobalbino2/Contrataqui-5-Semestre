<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ContrataquiMobile.Models"
             xmlns:views="clr-namespace:ContrataquiMobile.Views"
             x:Class="ContrataquiMobile.Views.Mensagens"
             x:DataType="views:Mensagens"
             Title="Mensagens"
             BackgroundColor="#F9F9FF"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Color x:Key="Primary">#002045</Color>
        <Color x:Key="Secondary">#13696A</Color>
        <Color x:Key="OnSurfaceVariant">#43474E</Color>
        <Color x:Key="SurfaceLow">#F0F3FF</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <views:Cabecalho x:Name="cab" />
            <Label Text="Mensagens"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   Padding="20,12,20,8" />
        </VerticalStackLayout>

        <RefreshView x:Name="rfv_lista"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Secondary}"
                     Refreshing="Atualizar_Refreshing">
            <ScrollView>
                <VerticalStackLayout Padding="20,4,20,24" Spacing="10">

                    <ActivityIndicator x:Name="ind_carregando"
                                       Color="{StaticResource Secondary}"
                                       IsRunning="False"
                                       IsVisible="False" />

                    <Label x:Name="lbl_erro"
                           FontSize="13"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalTextAlignment="Center"
                           IsVisible="False">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Erro_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <VerticalStackLayout x:Name="stk_vazio"
                                         IsVisible="False"
                                         Spacing="8"
                                         Padding="0,48,0,0"
                                         HorizontalOptions="Center">
                        <Label Text="&#xE0B7;"
                               FontFamily="MaterialIcons"
                               FontSize="56"
                               TextColor="#C4C6CF"
                               HorizontalOptions="Center" />
                        <Label Text="Nenhuma conversa ainda"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" />
                        <Label Text="O chat abre quando o profissional aceita uma solicitação."
                               FontSize="12"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10"
                                         BindableLayout.ItemsSource="{Binding Itens}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Chat">
                                <Border BackgroundColor="White"
                                        Stroke="#E1E8F5"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                        <Border WidthRequest="48"
                                                HeightRequest="48"
                                                BackgroundColor="#002045"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 24"
                                                VerticalOptions="Center">
                                            <Grid>
                                                <Label Text="{Binding OutroIniciais}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                                <Image Source="{Binding OutroFoto}"
                                                       IsVisible="{Binding OutroTemFoto}"
                                                       Aspect="AspectFill" />
                                            </Grid>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding OutroNome}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Titulo}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Secondary}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding UltimaTexto}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource OnSurfaceVariant}"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="2"
                                                IsVisible="{Binding TemNaoLidas}"
                                                BackgroundColor="{StaticResource Secondary}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 11"
                                                MinimumWidthRequest="22"
                                                HeightRequest="22"
                                                Padding="6,0"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding NaoLidasTexto}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Item_Tapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <views:BarraNavegacao Grid.Row="2" Ativo="mensagens" />

    </Grid>
</ContentPage>
