<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ContrataquiMobile.Views"
             x:Class="ContrataquiMobile.Views.Configuracoes"
             Title="Configurações"
             BackgroundColor="#F9F9FF"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Color x:Key="Primary">#002045</Color>
        <Color x:Key="PrimaryContainer">#1A365D</Color>
        <Color x:Key="Secondary">#13696A</Color>
        <Color x:Key="OnSurface">#111C2C</Color>
        <Color x:Key="OnSurfaceVariant">#43474E</Color>
        <Color x:Key="Outline">#74777F</Color>
        <Color x:Key="Perigo">#BA1A1A</Color>

        <Style x:Key="TituloGrupo" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1" />
            <Setter Property="TextColor" Value="{StaticResource Outline}" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="4"
              Padding="12,12,20,12">
            <Grid WidthRequest="44" HeightRequest="44">
                <Label Text="&#xE5C4;"
                       FontFamily="MaterialIcons"
                       FontSize="24"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Voltar_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>
            <Label Grid.Column="1"
                   Text="Configurações"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryContainer}"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,32" Spacing="20">

                <!-- Segurança -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="SEGURANÇA" Style="{StaticResource TituloGrupo}" />
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="14"
                                  Padding="16,14"
                                  BackgroundColor="White">
                                <Label Text="&#xE897;"
                                       FontFamily="MaterialIcons"
                                       FontSize="22"
                                       TextColor="{StaticResource Secondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Alterar senha"
                                       FontSize="14"
                                       TextColor="{StaticResource OnSurface}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="#9AA0A8"
                                       VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AlterarSenha_Tapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Sobre -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="SOBRE" Style="{StaticResource TituloGrupo}" />
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="14"
                                  Padding="16,14"
                                  BackgroundColor="White">
                                <Label Text="&#xE873;"
                                       FontFamily="MaterialIcons"
                                       FontSize="22"
                                       TextColor="{StaticResource Secondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Termos de Uso"
                                       FontSize="14"
                                       TextColor="{StaticResource OnSurface}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="#9AA0A8"
                                       VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Termos_Tapped" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E1E8F5" Margin="16,0" />

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="14"
                                  Padding="16,14"
                                  BackgroundColor="White">
                                <Label Text="&#xE32A;"
                                       FontFamily="MaterialIcons"
                                       FontSize="22"
                                       TextColor="{StaticResource Secondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Política de Privacidade"
                                       FontSize="14"
                                       TextColor="{StaticResource OnSurface}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="#9AA0A8"
                                       VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Privacidade_Tapped" />
                                </Grid.GestureRecognizers>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Conta -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="CONTA" Style="{StaticResource TituloGrupo}" />
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14"
                                  Padding="16,14"
                                  BackgroundColor="White">
                                <Label Text="&#xE879;"
                                       FontFamily="MaterialIcons"
                                       FontSize="22"
                                       TextColor="{StaticResource Perigo}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Sair da conta"
                                       FontSize="14"
                                       TextColor="{StaticResource Perigo}"
                                       VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Sair_Tapped" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E1E8F5" Margin="16,0" />

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14"
                                  Padding="16,14"
                                  BackgroundColor="White">
                                <Label Text="&#xE872;"
                                       FontFamily="MaterialIcons"
                                       FontSize="22"
                                       TextColor="{StaticResource Perigo}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Excluir minha conta"
                                       FontSize="14"
                                       TextColor="{StaticResource Perigo}"
                                       VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Excluir_Tapped" />
                                </Grid.GestureRecognizers>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label x:Name="lbl_versao"
                       FontSize="12"
                       TextColor="{StaticResource Outline}"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <views:BarraNavegacao Grid.Row="2" />

    </Grid>
</ContentPage>