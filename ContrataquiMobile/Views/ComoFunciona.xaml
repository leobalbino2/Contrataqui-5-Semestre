<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ContrataquiMobile.Models"
             xmlns:views="clr-namespace:ContrataquiMobile.Views"
             x:Class="ContrataquiMobile.Views.ComoFunciona"
             x:DataType="views:ComoFunciona"
             Title="Como funciona"
             BackgroundColor="#F9F9FF"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Color x:Key="Primary">#002045</Color>
        <Color x:Key="PrimaryContainer">#1A365D</Color>
        <Color x:Key="Secondary">#13696A</Color>
        <Color x:Key="Accent">#FFB866</Color>
        <Color x:Key="OnAccent">#321B00</Color>
        <Color x:Key="OnSurfaceVariant">#43474E</Color>

        <Style x:Key="Eyebrow" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.5" />
        </Style>

        <Style x:Key="SecaoTitulo" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
        </Style>

        <Style x:Key="Texto" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
        </Style>

        <!-- Passo do cliente: cartão claro -->
        <DataTemplate x:Key="PassoCliente" x:DataType="models:Passo">
            <Border BackgroundColor="#F0F3FF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border WidthRequest="44"
                            HeightRequest="44"
                            BackgroundColor="#E7EEFF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Start">
                        <Label Text="{Binding Numero}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="{Binding Titulo}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding Descricao}" Style="{StaticResource Texto}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Passo do profissional: círculo escuro -->
        <DataTemplate x:Key="PassoProfissional" x:DataType="models:Passo">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{StaticResource PrimaryContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        VerticalOptions="Start">
                    <Label Text="{Binding Numero}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="{Binding Titulo}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding Descricao}" Style="{StaticResource Texto}" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>

        <!-- Item de segurança -->
        <DataTemplate x:Key="ItemSeguranca" x:DataType="models:Passo">
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#E6F6F6"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            VerticalOptions="Start">
                        <Label Text="{Binding Numero}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="{Binding Titulo}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding Descricao}" Style="{StaticResource Texto}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="4"
              Padding="12,12,20,12">
            <Grid WidthRequest="44" HeightRequest="44">
                <Label Text="&#xE5C4;"
                       FontFamily="MaterialIcons"
                       FontSize="24"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Voltar_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>
            <Label Grid.Column="1"
                   Text="Como funciona"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryContainer}"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,32" Spacing="32">

                <!-- Hero -->
                <Border BackgroundColor="{StaticResource PrimaryContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="22">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Como o Contrataqui funciona"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Conectamos proprietários a profissionais qualificados de forma simples, segura e transparente. Escolha seu perfil e descubra as vantagens."
                               FontSize="14"
                               TextColor="#D6E3FF" />
                    </VerticalStackLayout>
                </Border>

                <!-- Para clientes -->
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PARA CLIENTES"
                               Style="{StaticResource Eyebrow}"
                               TextColor="{StaticResource Secondary}" />
                        <Label Text="Encontre o profissional perfeito em 4 passos"
                               Style="{StaticResource SecaoTitulo}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding PassosCliente}"
                                         BindableLayout.ItemTemplate="{StaticResource PassoCliente}" />
                </VerticalStackLayout>

                <!-- Para profissionais -->
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PARA PROFISSIONAIS"
                               Style="{StaticResource Eyebrow}"
                               TextColor="#D4903B" />
                        <Label Text="Transforme suas habilidades em lucro"
                               Style="{StaticResource SecaoTitulo}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="18"
                                         BindableLayout.ItemsSource="{Binding PassosProfissional}"
                                         BindableLayout.ItemTemplate="{StaticResource PassoProfissional}" />
                </VerticalStackLayout>

                <!-- Segurança -->
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sua segurança é nossa prioridade"
                               Style="{StaticResource SecaoTitulo}" />
                        <Label Text="Trabalhamos para garantir uma experiência livre de preocupações."
                               Style="{StaticResource Texto}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding Seguranca}"
                                         BindableLayout.ItemTemplate="{StaticResource ItemSeguranca}" />
                </VerticalStackLayout>

                <!-- CTA -->
                <Border BackgroundColor="{StaticResource PrimaryContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="22">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Pronto para começar?"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Junte-se à maior comunidade de serviços residenciais do país. Seja como cliente ou como profissional, o sucesso começa aqui."
                               FontSize="13"
                               TextColor="#D6E3FF" />
                        <Button Text="Encontrar profissional"
                                Clicked="Encontrar_Clicked"
                                BackgroundColor="{StaticResource Accent}"
                                TextColor="{StaticResource OnAccent}"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="8"
                                HeightRequest="48"
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <views:BarraNavegacao Grid.Row="2" />

    </Grid>
</ContentPage>